  "runner_source": "import json, hashlib, statistics, sys\nfrom collections import Counter\nfrom pathlib import Path\nROOT=Path('/Users/tobiasduerschmid/Projects/edbot'); D=ROOT/'output/profiling'\nreview=json.loads((D/'cs35l-semantic-review-v1.json').read_text())\n\ndef stats(values):\n v=sorted(values)\n if not v:return None\n pos=(len(v)-1)*.95;lo=int(pos);hi=min(lo+1,len(v)-1)\n return {'n':len(v),'sum':sum(v),'median':statistics.median(v),'mean':statistics.mean(v),'p95_linear':v[lo]+(v[hi]-v[lo])*(pos-lo),'min':v[0],'max':v[-1]}\n\ndef summarize(cases, reviews):\n byid={r['case_id']:r for r in reviews};turns=[t for c in cases for t in (c.get('profile') or {}).get('turns',[])];ok=[t for t in turns if t['success']]\n relevant=[byid[c['case']['id']] for c in cases if c['case']['id'] in byid]\n issues=Counter(cat for c in relevant for t in c['turns'] for cat in set(t['categories']))\n return {'observed_cases':len(cases),'execution_counts':dict(Counter(c['execution'] for c in cases)),'profiled_turns':len(turns),'successful_turns':len(ok),'failed_turns':len(turns)-len(ok),'captured_observations':sum(len(c['observations']) for c in cases),'turn_seconds_successful':stats([t['total_s'] for t in ok]),'visible_ttft_seconds_successful':stats([t['visible_ttft_s'] for t in ok if t.get('visible_ttft_s') is not None]),'model_calls_successful':stats([t['metrics']['model_call_count'] for t in ok]),'model_calls_all':sum(t['metrics']['model_call_count'] for t in turns),'episode_verdicts':dict(Counter(c.get('episode_verdict','pending') for c in relevant)),'turn_verdicts':dict(Counter(t['verdict'] for c in relevant for t in c['turns'])),'issue_turn_counts_nonexclusive':dict(sorted(issues.items())),'cases':[{'id':c['case']['id'],'execution':c['execution'],'turns':len((c.get('profile') or {}).get('turns',[])),'verdict':byid.get(c['case']['id'],{}).get('episode_verdict','unreviewed')} for c in cases]}\n\nreports={};results={};validations=[]\nfor kind,name in [('fixed','cs35l-studentlike-v2.json'),('adaptive','cs35l-adaptive-v2.json')]:\n p=D/name\n if not p.exists():continue\n d=json.loads(p.read_text()); reports[kind]=d\n results[kind]={'report':name,'report_sha256':hashlib.sha256(p.read_bytes()).hexdigest(),'execution':d['execution'],**summarize(d['cases'],review[kind])}\n if kind=='fixed':\n  results['fixed_unique']=summarize([c for c in d['cases'] if not c['case']['id'].endswith('-repeat')],review[kind])\n  results['fixed_repeat']=summarize([c for c in d['cases'] if c['case']['id'].endswith('-repeat')],review[kind])\n ids=[c['case']['id'] for c in d['cases']]; rids=[r['case_id'] for r in review[kind]]\n validations.append({'cohort':kind,'unique_case_ids':len(ids)==len(set(ids)),'unique_review_ids':len(rids)==len(set(rids)),'review_case_ids_match':set(ids)==set(rids),'all_episode_profiles_present':all(c.get('profile') is not None for c in d['cases']),'review_turn_counts_match':all(len(next((r['turns'] for r in review[kind] if r['case_id']==c['case']['id']),[]))==len((c.get('profile') or {}).get('turns',[])) for c in d['cases']),'observation_profile_counts_match':all(len(c['observations'])==len((c.get('profile') or {}).get('turns',[])) for c in d['cases'])})\nallcases=[c for d in reports.values() for c in d['cases']];allreviews=review['fixed']+review['adaptive'];results['all']=summarize(allcases,allreviews)\nprint(json.dumps({k:{kk:vv for kk,vv in v.items() if kk not in ['cases','issue_turn_counts_nonexclusive']} for k,v in results.items()},indent=2))\nif '--save' in sys.argv:\n assert len(reports['fixed']['cases'])==36 and len(reports['adaptive']['cases'])==8\n assert all(d['execution']!='running' for d in reports.values())\n assert all(all(v for k,v in x.items() if k!='cohort') for x in validations),validations\n assert results['fixed']['profiled_turns']==83\n for d in reports.values():\n  for c in d['cases']:\n   for t,o in zip(c['profile']['turns'],c['observations']):\n    assert t['prompt']==o['prompt']\n payload={'limits':'Descriptive counts from a purposive synthetic suite; single-reviewer judgments, not learning effects or population rates. Episode verdict is worst observed issue and may concern private artifacts. Timing under overlapping work is not a speedup comparison. Logical model calls exclude hidden retries. Failed public replies remain unassessed.','percentile_method':'Linear interpolation at (n-1)*p','validation':validations,'cohorts':results,'runner_source':Path(__file__).read_text()}\n (D/'cs35l-summary-v1.json').write_text(json.dumps(payload,indent=2)+'\\n')\n"
